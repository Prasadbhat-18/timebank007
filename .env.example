# ─── DATABASE & AUTH ────────────────────────────────────────────────────────
# Secret: Your private MongoDB connection string with credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ngfpvkp.mongodb.net/timebank?appName=Cluster0

# Secret: Random long string used to cryptographically sign user session tokens
JWT_SECRET=your_random_jwt_secret_key_here

PORT=5000
NODE_ENV=production

# ─── FRONTEND URL ───────────────────────────────────────────────────────────
# Non-secret: Public domain of your deployed application
CLIENT_URL=https://your-site.netlify.app

# ─── REAL-TIME EMAIL (GMAIL SMTP) ───────────────────────────────────────────
# Non-secret: SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Non-secret: Your service email address
SMTP_USER=timebank.verify@gmail.com

# ⚠️ SECRET: 16-character Gmail App Password (never share this publicly)
SMTP_PASS=your_16_character_gmail_app_password

# Non-secret: Display sender name and email
SMTP_FROM="TimeBank Verification" <timebank.verify@gmail.com>

# ─── WEB PUSH NOTIFICATIONS (VAPID KEYS) ────────────────────────────────────
# Non-secret: Public key for client browser push subscription
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ⚠️ SECRET: Private key for signing push notification payloads
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ─── BLOCKCHAIN & AMOY TESTNET ──────────────────────────────────────────────
# Non-secret: Public RPC endpoint for Polygon Amoy
POLYGON_AMOY_RPC=https://polygon-amoy-bor-rpc.publicnode.com

# ⚠️ SECRET: Private key of the relayer wallet that signs on-chain state transactions
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Non-secret: Contract address deployed on Polygon Amoy (optional)
TIMECREDIT_CONTRACT_ADDRESS=

# ─── AI / GEMINI API ────────────────────────────────────────────────────────
# ⚠️ SECRET: Your Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
